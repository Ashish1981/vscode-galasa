{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2020",
        "lib": ["es2020"],
        "esModuleInterop": false,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "outDir": "out-test",
        "sourceMap": true,
        "types": ["node", "mocha", "chai", "sinon"]
    },
    "include": ["src/**/*.ts", "test/**/*.ts"],
    "exclude": ["node_modules"]
}
